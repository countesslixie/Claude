# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local data & document vault (never committed — see SPEC.md 4/14)
/data/*
!/data/.gitkeep
# the Prisma CLI (unlike the app at runtime) resolves a relative sqlite
# DATABASE_URL against prisma/schema.prisma's directory, not cwd — running
# `prisma migrate deploy`/`db push` from the repo root leaves a stray copy
# here rather than in /data. Never commit it either.
/prisma/data/
/storage/*
!/storage/.gitkeep

# typescript
*.tsbuildinfo
next-env.d.ts

# real client figures used for manual verification — never committed
/scripts/real-fixture.local.ts
