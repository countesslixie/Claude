// Prisma schema for the BIR 8% Freelancer Practice Manager.
// See SPEC.md section 5 for the authoritative data model description.
// Money fields are always Int centavos (see lib/money.ts `Cents` alias).
// Never store money as Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TaxpayerType {
  PURELY_SELF_EMPLOYED
  MIXED_INCOME
}

enum BooksType {
  MANUAL
  LOOSE_LEAF
  CAS
}

enum CivilStatus {
  SINGLE
  MARRIED
  WIDOWED
  LEGALLY_SEPARATED
  ANNULLED
}

// Open Question 2: revenue recognition basis, per client.
enum RecognitionBasis {
  COLLECTION
  BILLING
}

enum Regime {
  RATE_8_PERCENT
  GRADUATED_OSD
  GRADUATED_ITEMIZED
}

enum ElectionStatus {
  ELECTED
  NOT_YET_ELECTED
  DEFAULTED_GRADUATED
}

enum YearEndCreditElection {
  REFUND
  TCC
  CARRY_OVER
  NA
}

enum SalesQuarter {
  Q1
  Q2
  Q3
  Q4
}

// Brief #5f §8 — a mid-year client's latest return filed OUTSIDE the app,
// from her own Excel/eBIRForms records. NONE means the client starts in
// the app from Q1; Q1/Q2/Q3 mean that quarter (and every quarter up to
// it) was filed outside the app, so the app's first return is the next
// one in sequence (Q2/Q3/ANNUAL respectively). There is no "ANNUAL"
// value here — the Annual can never itself have been filed outside the
// app while leaving a later in-app period, since it's the last period of
// the year.
enum LatestOutsideReturn {
  NONE
  Q1
  Q2
  Q3
}

enum Form2307Status {
  RECEIVED
  RECORDED
  CLAIMED_ON_RETURN
  INCLUDED_IN_SAWT
  ACKNOWLEDGED
  VALIDATED
}

enum Period {
  Q1
  Q2
  Q3
  ANNUAL
}

enum FormType {
  F1701Q
  F1701A
  F1701
}

enum FilingStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING_CLIENT
  WAITING_BIR
  BLOCKED
  COMPLETE
  NA
}

enum WorkflowStepCategory {
  PREP
  FILING
  PAYMENT
  SAWT
  ATTACHMENT
  CLIENT_COMM
}

enum WorkflowStepStatus {
  PENDING
  IN_PROGRESS
  WAITING_EXTERNAL
  DONE
  SKIPPED
  NA
}

enum DocumentCategory {
  FORM_2307_SCAN
  SOURCE_RECEIPT
  COMPUTATION_SHEET
  ADVISORY_EVIDENCE
  SUBMISSION_SCREENSHOT
  FILED_FORM
  PAYMENT_CONFIRMATION
  TRRC
  ALPHALIST_REPORT
  DAT_FILE
  SENT_EMAIL_EVIDENCE
  ACKNOWLEDGEMENT
  VALIDATION_EMAIL
  EAFS_CONFIRMATION
  ELECTION_EVIDENCE
  OTHER
}

enum SawtBatchStatus {
  GENERATED
  EMAILED
  ACKNOWLEDGED
  VALIDATED
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
}

enum HolidayType {
  REGULAR
  SPECIAL_NON_WORKING
}

enum HolidayScope {
  NATIONAL
  LOCAL
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Client {
  id   String @id @default(cuid())
  code String @unique // short slug, used in storage file paths

  registeredName String
  tradeName      String?

  tin        String // 9 digits
  branchCode String @default("000")
  rdoCode    String

  registeredAddress String
  email             String?
  mobile            String?

  taxpayerType   TaxpayerType
  lineOfBusiness String?
  psicCode       String?
  civilStatus    CivilStatus?

  booksType             BooksType
  booksRegistrationDate DateTime?
  booksPermitNumber     String?

  swornDeclarationOnFile Boolean @default(false)
  swornDeclarationYear   Int?

  eBIRFormsEmail            String?
  eFPSEnrolled              Boolean @default(false)
  defaultWithholdingRateBps Int? // basis points, e.g. 500 = 5.00%

  recognitionBasis RecognitionBasis @default(COLLECTION)

  isActive     Boolean   @default(true)
  engagedSince DateTime?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  actorId   String?

  taxYears        ClientTaxYear[]
  quarterlySales  QuarterlySales[]
  form2307s       Form2307[]
  filings         Filing[]
  documents       Document[]
  sawtBatches     SawtBatch[]
  payors          Payor[]
  startingFigures StartingFigures[]

  @@index([isActive])
}

// Brief #5a — one saved list per client of companies she deals with, since
// the same company is usually both a customer recorded in step 1 and the
// payor of a 2307 she receives in step 2. Purely a shared reference of
// names/details: picking a saved entry only pre-fills fields on one
// customer row or one certificate, which stays independently editable
// from there — nothing here feeds gross sales or a certificate's own
// numbers, and there is no foreign key from QuarterlySalesCustomer or
// Form2307 back to this table (D26/D33 stay untouched; a certificate
// still cannot affect gross sales). usualAtcCode is a plain AtcCode.code
// string, not a hard FK, so a later code change/deactivation never
// breaks a saved entry.
model Payor {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  name         String
  tin          String?
  address      String?
  usualAtcCode String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  actorId   String?

  @@unique([clientId, name])
  @@index([clientId, isActive])
}

// One row per client per taxable year per sales quarter — the only place
// income enters the system (D26: declared gross sales, independent of
// any Form 2307). Q1-Q3 feed the quarterly returns; Q4 has no quarterly
// return of its own and is picked up by the ANNUAL return (see
// lib/tax/quarterlySales.ts's cumulative mapping). A missing row for a
// quarter is treated as zero, not an error.
//
// Brief #4b (D33) — gross sales is now the sum of zero or more per-customer
// rows (QuarterlySalesCustomer). grossSalesCents stays on this row as the
// figure the tax engine reads, but it is derived/recomputed from the
// customer rows on every write, never typed directly. noSalesThisQuarter
// records a deliberate "no sales this quarter" ₱0, distinct from a
// quarter with no row at all (hasSalesRecordedForPeriod). finalizedAt is
// set the first time this quarter is Saved for real (not as a draft) and,
// once set, is never cleared by further edits — it drives step 1's
// derived Done status.
model QuarterlySales {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  taxableYear Int
  quarter     SalesQuarter

  grossSalesCents         Int
  nonOperatingIncomeCents Int       @default(0)
  noSalesThisQuarter      Boolean   @default(false)
  finalizedAt             DateTime?

  // Brief #4c — the "where this figure came from" field is removed
  // (bookkeeper's decision, supersedes the old locked source-of-figure
  // rule); the column itself is dropped, not kept unused.
  notes String?

  customers QuarterlySalesCustomer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  actorId   String?

  @@unique([clientId, taxableYear, quarter])
  @@index([clientId, taxableYear])
}

// Brief #4b (D33) — one row per customer contributing to a quarter's gross
// sales. The quarter's grossSalesCents is the sum of these rows; rows are
// freely added/removed and fully replaced on every save of their quarter.
model QuarterlySalesCustomer {
  id               String         @id @default(cuid())
  quarterlySalesId String
  quarterlySales   QuarterlySales @relation(fields: [quarterlySalesId], references: [id], onDelete: Cascade)

  customerName String
  amountCents  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quarterlySalesId])
}

// One row per client per taxable year. Anchor for annual state.
model ClientTaxYear {
  id          String @id @default(cuid())
  clientId    String
  client      Client @relation(fields: [clientId], references: [id])
  taxableYear Int

  regime                Regime
  electionStatus        ElectionStatus @default(NOT_YET_ELECTED)
  electionEvidenceDocId String?

  // Brief #5f §4 — item 55, display-only from here on. The only place it
  // is ENTERED is the starting figures page (StartingFigures below); this
  // column stays the field the tax engine actually reads, and still
  // appears in full on every return of the year (locked rule #1, SPEC §16
  // item 7). Otherwise 0 — automatic carry-over from last year's Annual
  // overpayment is deferred to the Pay group work (not built here).
  priorYearExcessCreditCents Int                   @default(0)
  yearEndCreditElection      YearEndCreditElection @default(NA)

  thresholdBreachedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  actorId   String?

  startingFigures StartingFigures?

  @@unique([clientId, taxableYear])
  @@index([taxableYear])
}

// Brief #5f §8 — the handful of figures a mid-year client brings into the
// app from her own outside-the-app filing (Excel/eBIRForms). One row per
// client-year, entered once from the client's Taxable years row, and
// carried forward into the app's own first return of the year and into
// the Annual (see lib/filingComputation.ts). Editable until that year's
// first in-app return is filed (step 5, FILE_RETURN, DONE) — enforced
// server-side in lib/actions/startingFigures.ts, not stored as a separate
// flag here, since it's fully derived from the Filing/WorkflowStep rows
// that already exist.
model StartingFigures {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  taxableYear Int

  clientTaxYearId String        @unique
  clientTaxYear   ClientTaxYear @relation(fields: [clientTaxYearId], references: [id])

  latestOutsideReturn LatestOutsideReturn

  // Item 55 — always entered here, regardless of latestOutsideReturn
  // (even a from-Q1 client's prior-year excess credit, if any, is entered
  // this way — see ClientTaxYear.priorYearExcessCreditCents, which this
  // writes through to on every save). The remaining fields below only
  // apply when latestOutsideReturn is not NONE and are 0 otherwise.
  priorYearExcessCreditCents Int @default(0)

  // Item 51 of the latest outside return.
  cumulativeIncomeCents            Int     @default(0)
  // Item 57 of the latest outside return.
  withholdingPreviousQuartersCents Int     @default(0)
  // Item 58 of the latest outside return.
  withholdingThisQuarterCents      Int     @default(0)
  // Item 56 of the latest outside return.
  paymentsPreviousQuartersCents    Int     @default(0)
  // Her proof of payment for the latest outside return (0 if it was an overpayment).
  amountPaidThisReturnCents        Int     @default(0)
  // Item 61 of the latest outside return — feeds the in-app inheritance
  // chain on Filing.otherCreditsCents (brief #5f §3).
  otherCreditsCents                Int     @default(0)
  otherCreditsDescription          String?
  // Optional, defaults to 0 — non-operating income earned so far this
  // year before the app took over. Can't exceed cumulativeIncomeCents.
  nonOperatingIncomeCents          Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  actorId   String?

  @@unique([clientId, taxableYear])
}

model Form2307 {
  id          String @id @default(cuid())
  clientId    String
  client      Client @relation(fields: [clientId], references: [id])
  taxableYear Int

  // Brief #5a — payorTin and payorAddress are now required at entry
  // (validated server-side, lib/validation/form2307.ts); the columns stay
  // nullable here only because certificates entered before this brief may
  // lack them.
  payorName    String
  payorTin     String?
  payorAddress String?

  periodFrom     DateTime
  periodTo       DateTime
  quarterCovered Int

  // Brief #5a — atcCode is now required and chosen from a picker of
  // active AtcCode rows (never free-typed, never invented — D19); this
  // stays a plain code string, not a hard FK, so a later deactivation or
  // edit of the AtcCode row never rewrites or breaks an already-saved
  // certificate. withholdingRateBps defaults to the chosen code's own
  // rate; rateOverridden records when she typed a different rate for this
  // one certificate instead (the certificate is authoritative over the
  // code when they disagree — her value is kept either way).
  atcCode            String
  incomePaymentCents Int
  taxWithheldCents   Int
  withholdingRateBps Int
  rateOverridden     Boolean @default(false)

  // Brief #4d — dateReceived is removed entirely. It was kept in brief
  // #4c because the SAWT keying worksheet's row order and the annual
  // certificates-vs-declared-sales check both still read it; both were
  // switched to read the filing it was entered under instead (the SAWT
  // worksheet now sorts by payorName/payorTin; the reconciliation always
  // used Form2307.taxableYear, itself set from the filing at entry, so it
  // needed no code change — only the test proving it).
  status Form2307Status @default(RECEIVED)

  documentId      String?
  primaryDocument Document? @relation("Form2307PrimaryDocument", fields: [documentId], references: [id])

  // D34 (brief #4b, supersedes D10) — set once, at entry, to the filing
  // whose step 2 this certificate was entered under. This is now what
  // decides the certificate's credit period: it counts cumulatively from
  // that filing's period onward (lib/tax/cwt.ts), never reassigned by
  // dateReceived or a cutoff date. Locked once that filing's step 5
  // (FILE_RETURN) is DONE — a certificate arriving after filing is
  // entered under the next open filing instead (D11: no amended returns).
  claimedOnFilingId String?
  claimedOnFiling   Filing?    @relation(fields: [claimedOnFilingId], references: [id])
  sawtBatchId       String?
  sawtBatch         SawtBatch? @relation(fields: [sawtBatchId], references: [id])

  notes String?

  deletedAt     DateTime?
  deletedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  actorId   String?

  documents Document[] @relation("DocumentToForm2307")

  @@index([clientId, taxableYear, quarterCovered])
}

// One row per client per period per taxable year.
model Filing {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  taxableYear Int
  period      Period
  formType    FormType

  statutoryDueDate DateTime
  adjustedDueDate  DateTime // after holiday/weekend shift — the authoritative legal deadline

  // Working calendar (SPEC.md 3.6, Phase 2b P7) — the bookkeeper's own
  // practice targets, distinct from and editable independent of the
  // statutory/adjusted due date above. eAFS is NOT stored here; it is
  // always derived via lib/tax/deadlines.ts's eafsDueDate() (Phase 2b P6).
  certificatesExpectedBy DateTime?
  internalFilingTarget   DateTime?

  status       FilingStatus @default(NOT_STARTED)
  requiresSawt Boolean      @default(false) // derived: any Form2307 in period

  computationSnapshot Json? // FROZEN once filedAt is set; never rewritten silently

  // Brief #4b (D34) — step 2's "All certificates received" checkbox.
  // Step 2 (RECEIVE_2307) is DONE only once this is set AND every
  // certificate entered under this filing (Form2307.claimedOnFilingId)
  // has its own scan attached; unticking reverts step 2 to not-done so a
  // late-arriving certificate can be added before filing.
  certificatesAllReceivedAt DateTime?

  filedAt               DateTime?
  filingReferenceNumber String?

  amountPaidCents Int?
  paymentDate     DateTime?
  paymentChannel  String?

  // Brief #4d — the PREPARE_RETURN "client confirmation" box (a yes/no
  // acknowledgement plus optional note) is removed entirely, the
  // bookkeeper's own decision. It never blocked anything; step 3 is now
  // just the computation sheet preview and the usual step controls. Both
  // columns this once carried (receiptsAcknowledgedAt/Note) are dropped —
  // brief #4c had already dropped a third, receiptsAcknowledgedSourceNote.

  // Informational completeness note (§5.3) — lists documents not yet
  // attached across the filing's steps. Amber, never blocking. Dismissing
  // it hides it on this filing; it does not reappear on its own.
  completenessNoteDismissedAt DateTime?

  // Brief #5e §3 — step 4's client advice message, saved exactly as sent
  // at the moment ADVISE_CLIENT is marked Done (lib/actions/workflowSteps.ts's
  // markStepDone). Kept unchanged by any later edit; cleared when
  // reopenPreparedFiling resets step 4 back to PENDING, so the card knows
  // to show the live-rebuilt preview again instead of stale saved text.
  adviceMessageSubject String?
  adviceMessageBody    String?
  adviceMessageSavedAt DateTime?

  // Brief #5o §4 (D87) — step 12's "Email DAT file to BIR eSubmission": the
  // exact draft (to/subject/body) saved when step 12 is marked Done, the
  // same pattern as step 4's advice message above. Null until then.
  dataEmailTo      String?
  dataEmailSubject String?
  dataEmailBody    String?
  dataEmailSavedAt DateTime?

  // Brief #5r (D101) — step 16's client email, saved exactly as sent when
  // SEND_CLIENT_PACKAGE is marked Done (same pattern as step 4 and step 12).
  // Null until then, and stays null for a filing whose step 16 was Done
  // before this existed — the card then shows "Done [date]" with no email.
  clientPackageEmailTo      String?
  clientPackageEmailSubject String?
  clientPackageEmailBody    String?
  clientPackageEmailSavedAt DateTime?

  // Brief #5f §3 — item 61 (1701Q) / item 63 (1701A), "Other Tax
  // Credits/Payments." One figure PER RETURN now (supersedes brief #5e's
  // year-level ClientTaxYear.otherCreditsCents) — it can change from
  // quarter to quarter. Null means "not yet saved on this filing," which
  // is what makes the inheritance chain in lib/filingComputation.ts's
  // effectiveOtherCreditsFor work: never store an inherited figure by
  // copying it in, only the fact that nothing has been saved here yet.
  // Locked once this filing's own step 5 (FILE_RETURN) is DONE.
  otherCreditsCents       Int?
  otherCreditsDescription String?

  // Brief #5f §8 — true for a Filing row that predates a client-year's
  // starting figures naming its period "filed outside the app" (the
  // ordinary case is simpler: generateFilingsForClientYear just never
  // creates a Filing row for such a period at all, so most outside
  // periods carry no row and this flag never comes into play). Set/
  // cleared by lib/actions/startingFigures.ts's saveStartingFigures
  // whenever the chosen latestOutsideReturn changes. A true row carries
  // no workflow, is excluded from the board and dashboard, and renders on
  // the client page as "Filed outside the app," never as ordinary work.
  filedOutsideApp Boolean @default(false)

  notes String?

  deletedAt     DateTime?
  deletedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  actorId   String?

  workflowSteps    WorkflowStep[]
  documents        Document[]
  form2307sClaimed Form2307[]
  amendmentAlerts  AmendmentAlert[]

  @@unique([clientId, taxableYear, period])
  @@index([clientId, taxableYear])
  @@index([adjustedDueDate])
}

// Records the delta when a transaction is edited after a Filing's
// computationSnapshot has been frozen. Never auto-resolved.
model AmendmentAlert {
  id               String    @id @default(cuid())
  filingId         String
  filing           Filing    @relation(fields: [filingId], references: [id])
  reason           String
  snapshotJson     Json // frozen computation at time of filing
  recomputedJson   Json // live recomputation at time the alert was raised
  deltaCents       Int
  acknowledgedAt   DateTime?
  acknowledgedNote String?
  createdAt        DateTime  @default(now())
  actorId          String?

  @@index([filingId])
}

// Editable template. Instantiated into WorkflowStep rows when a Filing is created.
model WorkflowStepTemplate {
  id          String  @id @default(cuid())
  stepCode    String  @unique
  sequence    Int
  title       String
  description String?

  category            WorkflowStepCategory
  isConditional       Boolean              @default(false)
  conditionExpression String? // e.g. "requiresSawt == true"

  isWaitingState Boolean @default(false)
  waitingOnLabel String? // e.g. "Client" or "BIR", display only

  expectedResponseDays Int?
  requiredDocSlots     Json // [{slotCode, label, required, acceptedTypes}]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowStep {
  id       String @id @default(cuid())
  filingId String
  filing   Filing @relation(fields: [filingId], references: [id], onDelete: Cascade)

  stepCode    String
  sequence    Int
  title       String
  description String?

  category WorkflowStepCategory
  status   WorkflowStepStatus   @default(PENDING)

  isConditional       Boolean @default(false)
  conditionExpression String?

  isWaitingState       Boolean   @default(false)
  waitingOnLabel       String? // e.g. "Client" or "BIR" — copied from the template at instantiation; drives Filing status derivation (SPEC.md 7.2)
  expectedResponseDays Int?
  waitingSince         DateTime?
  followUpCount        Int       @default(0)

  requiredDocSlots Json // [{slotCode, label, required, acceptedTypes}]

  startedAt     DateTime?
  completedAt   DateTime?
  skippedReason String?
  notes         String?
  actorId       String?

  documents Document[]

  @@index([filingId, sequence])
  @@index([status])
}

model Document {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  filingId       String?
  filing         Filing?       @relation(fields: [filingId], references: [id])
  workflowStepId String?
  workflowStep   WorkflowStep? @relation(fields: [workflowStepId], references: [id])
  docSlotCode    String?
  form2307Id     String?
  form2307       Form2307?     @relation("DocumentToForm2307", fields: [form2307Id], references: [id])

  category DocumentCategory

  originalFilename String
  storedPath       String
  mimeType         String
  sizeBytes        Int
  sha256           String

  documentDate DateTime // date on the document, distinct from uploadedAt
  uploadedAt   DateTime @default(now())
  actorId      String?
  notes        String?

  deletedAt     DateTime?
  deletedReason String?

  form2307Primary Form2307[] @relation("Form2307PrimaryDocument")

  @@index([clientId])
  @@index([filingId])
  @@index([sha256])
}

// ---------------------------------------------------------------------------
// SAWT / Alphalist
// ---------------------------------------------------------------------------

model SawtBatch {
  id          String @id @default(cuid())
  clientId    String
  client      Client @relation(fields: [clientId], references: [id])
  taxableYear Int
  period      Period

  status         SawtBatchStatus @default(GENERATED)
  generatedAt    DateTime?
  emailedAt      DateTime?
  acknowledgedAt DateTime?
  validatedAt    DateTime?

  notes String?

  createdAt DateTime @default(now())
  actorId   String?

  form2307s Form2307[]

  @@unique([clientId, taxableYear, period])
}

// ---------------------------------------------------------------------------
// Reference / configuration tables
// ---------------------------------------------------------------------------

// Versioned tax configuration with effectivity dates. The engine reads the
// rule set applicable to the taxable year being computed. Never hardcode
// rates/thresholds/deadlines in application code.
model TaxRuleSet {
  id String @id @default(cuid())

  taxableYear   Int       @unique
  effectiveFrom DateTime
  effectiveTo   DateTime?

  incomeTaxRateBps        Int // e.g. 800 = 8.00%
  vatThresholdCents       Int // e.g. 300000000 = PHP 3,000,000.00
  allowableDeductionCents Int // PHP 250,000.00 for purely self-employed

  // Statutory due dates, stored as "MM-DD" strings (business-day shift
  // applied at Filing-generation time against the Holiday table).
  q1DueMonthDay     String // e.g. "04-15"
  q2DueMonthDay     String // e.g. "08-15"
  q3DueMonthDay     String // e.g. "11-15"
  annualDueMonthDay String // e.g. "04-15" of the FOLLOWING year

  sawtDeadlineOffsetDays Int @default(0) // from return deadline
  eafsDeadlineOffsetDays Int @default(15) // from date of filing

  // Brief #5e §9 — locked rule #5: the date shown to the CLIENT in step
  // 4's advice message is this many calendar days before the filing's own
  // adjusted BIR due date (shifted earlier on a weekend/holiday). Never a
  // literal in code; display-only, changes no real deadline.
  clientPaymentLeadDays Int @default(10)

  // Brief #5o §4 (D87) — the BIR eSubmission address step 12's email draft
  // is addressed to, as given by the bookkeeper (never a literal in code, D4).
  // Editable on the tax rule set screen; confirm it against BIR before live use (D19).
  eSubmissionEmail String @default("esubmission@bir.gov.ph")

  // Brief #5r (D102) — the bookkeeper's own date for receiving a client's
  // documents for the ANNUAL return, "MM-DD" of the year AFTER the taxable
  // year. Named in the step 16 email's "Next filing" line. Not the same as
  // internalFilingTarget (D14, her own filing target); never a literal in
  // code (D4).
  annualDocsDueMonthDay String @default("02-15")

  // Late filing exposure (informational only — see SPEC.md 3.7)
  surchargeRateBps          Int?
  interestRateBpsPerAnnum   Int?
  compromisePenaltySchedule Json?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  actorId   String?
}

model Holiday {
  id         String       @id @default(cuid())
  date       DateTime
  name       String
  type       HolidayType
  scope      HolidayScope @default(NATIONAL)
  localScope String? // e.g. city/province, required when scope = LOCAL

  createdAt DateTime @default(now())
  actorId   String?

  @@unique([date, localScope])
  @@index([date])
}

// Sparse, editable ATC reference table. Never invent codes/rates here —
// leave sparse and unverified until confirmed against the current BIR
// list. Brief #5a — maintained from Settings (add/edit/deactivate, never
// hard-deleted); the certificate form's ATC picker reads active rows from
// here and fills the rate from rateBps, since the rate is a property of
// the code, not a separately-typed figure.
model AtcCode {
  id          String  @id @default(cuid())
  code        String  @unique
  description String
  rateBps     Int
  payeeType   String? // free text, e.g. "Individual", "Corporate"

  verifiedAgainstIssuance Boolean @default(false)
  isActive                Boolean @default(true)
  notes                   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

// Append-only. Never hard-delete rows in this table.
model ActivityLog {
  id         String         @id @default(cuid())
  entityType String
  entityId   String
  action     ActivityAction
  beforeJson Json?
  afterJson  Json?
  // Brief #5i §2 — a short human-readable note for a log entry whose
  // before/after diff alone wouldn't say WHY, e.g. "Step 2 reopened: sales
  // changed." Optional; most entries still rely on the diff alone.
  note       String?
  actorId    String?
  at         DateTime       @default(now())

  @@index([entityType, entityId])
  @@index([at])
}
